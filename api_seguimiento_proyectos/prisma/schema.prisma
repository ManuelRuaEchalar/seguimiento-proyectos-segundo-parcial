// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model Usuario {
  id           Int         @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String      @unique
  hash         String
  rol          Rol
  refreshToken String?     
  estudiante   Estudiante?
  docente      Docente?
}

model Proyecto {
  codigoProyecto    Int               @id @default(autoincrement())
  titulo            String
  estudiantes       Estudiante[]      @relation("ProyectoEstudiantes")
  documentos        Documento[]
  observaciones     Observacion[]     @relation("ProyectoObservaciones")
  observacionesArea ObservacionArea[] @relation("ProyectoObservacionesArea")
  correcciones      Correccion[]      @relation("ProyectoCorrecciones")
}

model Observacion {
  id             String       @id 
  contentText    String?
  commentText    String?
  commentEmoji   String?
  estado         String

  boundingX1     Float
  boundingY1     Float
  boundingX2     Float
  boundingY2     Float
  boundingPage   Int
  rects          Json         

  codigoDoc      Int
  codigoProyecto Int

  proyecto       Proyecto      @relation("ProyectoObservaciones", fields: [codigoProyecto], references: [codigoProyecto])
  documento      Documento     @relation("DocumentoObservaciones", fields: [codigoDoc], references: [codigoDoc])

  correccion     Correccion?   @relation("ObservacionCorreccion")
}

model Correccion {
  id             String   @id
  contentText    String?
  commentText    String?
  commentEmoji   String?
  estado         String

  boundingX1     Float
  boundingY1     Float
  boundingX2     Float
  boundingY2     Float
  boundingPage   Int
  rects          Json     

  // Relación obligatoria con Observacion (1:1)
  observacionId  String   @unique
  observacion    Observacion @relation("ObservacionCorreccion", fields: [observacionId], references: [id])

  // Relación con Documento (N:1)
  codigoDoc      Int
  documento      Documento @relation("DocumentoCorrecciones", fields: [codigoDoc], references: [codigoDoc])

  // Relación con Proyecto (N:1)
  codigoProyecto Int
  proyecto       Proyecto  @relation("ProyectoCorrecciones", fields: [codigoProyecto], references: [codigoProyecto])
}

model ObservacionArea {
  id             String   @id 
  contentImage   String?  
  commentText    String?
  commentEmoji   String?
  estado         String

  boundingX1     Float
  boundingY1     Float
  boundingX2     Float
  boundingY2     Float
  boundingPage   Int
  rects          Json     

  codigoDoc      Int
  codigoProyecto Int

  proyecto       Proyecto  @relation("ProyectoObservacionesArea", fields: [codigoProyecto], references: [codigoProyecto])
  documento      Documento @relation("DocumentoObservacionesArea", fields: [codigoDoc], references: [codigoDoc])
}

model Documento {
  codigoDoc         Int               @id @default(autoincrement())
  titulo            String
  version           Int
  estado            String?
  fecha             DateTime          @default(now())         
  file              String
  proyectoId        Int
  proyecto          Proyecto          @relation(fields: [proyectoId], references: [codigoProyecto])

  observaciones     Observacion[]     @relation("DocumentoObservaciones")
  observacionesArea ObservacionArea[] @relation("DocumentoObservacionesArea")
  correcciones      Correccion[]      @relation("DocumentoCorrecciones")
}

model Estudiante {
  id          Int        @id
  usuario     Usuario    @relation(fields: [id], references: [id])
  cu          String
  carrera     String
  grupo_id    Int?
  grupo       Grupo?     @relation(fields: [grupo_id], references: [id])

  proyectoId  Int?       @unique
  proyecto    Proyecto?  @relation("ProyectoEstudiantes", fields: [proyectoId], references: [codigoProyecto])
}

model Docente {
  id        Int     @id
  usuario   Usuario @relation(fields: [id], references: [id])
  grupo_id  Int
  grupo     Grupo   @relation(fields: [grupo_id], references: [id])
}

model Grupo {
  id          Int          @id @default(autoincrement())
  nombre      String
  estudiantes Estudiante[]
  docentes    Docente[]
}

enum Rol {
  admin
  docente
  estudiante
}
