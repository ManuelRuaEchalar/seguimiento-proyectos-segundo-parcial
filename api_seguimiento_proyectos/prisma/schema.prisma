// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int         @id @default(autoincrement())
  nombre         String
  apellido       String
  email          String      @unique
  hash           String
  rol            Rol
  refresh_token  String?
  estudiante     Estudiante?
  docente        Docente?
}

model Grupo {
  id                     Int        @id @default(autoincrement())
  nombre                 String
  grado                  Grado
  estudiantes            Estudiante[]
  estudiantes_grado2    Estudiante[] @relation("GrupoDos") // relación secundaria
  docente_id             Int?
  docente                Docente?   @relation(fields: [docente_id], references: [id])
  actividades            Actividad[]

  total_actividades      Int        @default(0)
  total_estudiantes      Int        @default(0)
  fase                   String     @default("tema")
  elementos              Json?
  elementos_hechos       Json?
  fecha_ultima_actividad DateTime?

  fecha_inicio_tema      DateTime?
  fecha_fin_tema         DateTime?
  fecha_inicio_perfil    DateTime?
  fecha_fin_perfil       DateTime?
  fecha_inicio_proyecto  DateTime?
  fecha_fin_proyecto     DateTime?
}


model Estudiante {
  id              Int            @id
  usuario         Usuario        @relation(fields: [id], references: [id])
  cu              String
  carrera         String
  grupo_id        Int?
  grupo           Grupo?         @relation(fields: [grupo_id], references: [id])
  grupo_dos_id    Int?        // grupo de grado 2
  grupo_dos       Grupo?      @relation("GrupoDos", fields: [grupo_dos_id], references: [id])
  proyecto_id     Int?
  proyecto        Proyecto?      @relation("ProyectoEstudiantes", fields: [proyecto_id], references: [id])

  solicitudes_enviadas  Solicitud[] @relation("SolicitudesEnviadas")
  solicitudes_recibidas Solicitud[] @relation("SolicitudesRecibidas")
}


model Proyecto {
  id               Int             @id @default(autoincrement())
  titulo           String?
  fase_actual      FaseProyecto
  grado_actual     Grado
  estudiantes      Estudiante[]    @relation("ProyectoEstudiantes")
  documentos       Documento[]     @relation("ProyectoDocumentos")
  observaciones    Observacion[]   @relation("ProyectoObservaciones")
  finales          Final[]         
  solicitudes      Solicitud[]     // ← Agregar esta línea
}

model Documento {
  id             Int             @id @default(autoincrement())
  titulo         String
  version        Int
  estado         EstadoDocumento
  justificacion  String?
  created_at     DateTime @default(now())
  file           String

  proyecto_id    Int
  proyecto       Proyecto        @relation("ProyectoDocumentos", fields: [proyecto_id], references: [id])

  actividad_id   Int
  actividad      Actividad       @relation(fields: [actividad_id], references: [id])

  observaciones  Observacion[]   @relation("DocumentoObservaciones")
  correcciones   Correccion[]    @relation("DocumentoCorrecciones")
}

model Observacion {
  id             Int       @id @default(autoincrement()) 
  content_text   String?
  comment_text   String?
  comment_emoji  String?
  estado         String

  bounding_x1    Float
  bounding_y1    Float
  bounding_x2    Float
  bounding_y2    Float
  bounding_page  Int
  rects          Json
  correccion_id  Int?   @unique
  correccion     Correccion? @relation("CorreccionToObservacion", fields: [correccion_id], references: [id])

  respuesta      Correccion? @relation("ObservacionToCorreccion")

  documento_id   Int
  proyecto_id    Int

  proyecto       Proyecto      @relation("ProyectoObservaciones", fields: [proyecto_id], references: [id])
  documento      Documento     @relation("DocumentoObservaciones", fields: [documento_id], references: [id])
}

model Correccion {
  id              Int   @id @default(autoincrement())
  content_text    String?
  comment_text    String?
  comment_emoji   String?
  estado          String

  bounding_x1     Float
  bounding_y1     Float
  bounding_x2     Float
  bounding_y2     Float
  bounding_page   Int
  rects           Json     

  observacion_id  Int   @unique
  observacion     Observacion @relation("ObservacionToCorreccion", fields: [observacion_id], references: [id])

  observacion_rechazo Observacion? @relation("CorreccionToObservacion")

  documento_id    Int
  documento       Documento @relation("DocumentoCorrecciones", fields: [documento_id], references: [id])
}


model Docente {
  id        Int       @id
  especialidad String
  usuario   Usuario   @relation(fields: [id], references: [id])
  grupos    Grupo[]
}

model Actividad {
  id             Int              @id @default(autoincrement())
  nombre         String
  elementos      Json
  descripcion    String?
  fecha_creacion DateTime         @default(now())
  estado         EstadoActividad  @default(activo)
  fase           FaseProyecto
  es_final       Boolean          @default(false)

  grupo_id       Int
  grupo          Grupo            @relation(fields: [grupo_id], references: [id])

  documentos     Documento[]

  // Nueva relación con Final (1:N)
  finales        Final[]
}

model Solicitud {
  id           Int              @id @default(autoincrement())
  tipo         TipoSolicitud
  proyecto_id  Int
  proyecto     Proyecto         @relation(fields: [proyecto_id], references: [id])

  emisor_id    Int
  emisor       Estudiante       @relation("SolicitudesEnviadas", fields: [emisor_id], references: [id])

  receptor_id  Int
  receptor     Estudiante       @relation("SolicitudesRecibidas", fields: [receptor_id], references: [id])
  titulo       String

  aprobacion_receptor       EstadoSolicitud  @default(pendiente)
  aprobacion_docente EstadoSolicitud @default(pendiente)
  fecha_envio  DateTime         @default(now())
}

enum TipoSolicitud {
  unirse
  invitar
}

enum EstadoSolicitud {
  pendiente
  aceptado
  rechazado
}

model Final {
  id            Int          @id @default(autoincrement())
  titulo        String
  carrera       String
  año           Int
  estado        EstadoFinal  @default(pendiente)
  archivo       String
  fase          FaseFinal
  version       Int
  motivo_rechazo String?
  proyecto_id   Int
  proyecto      Proyecto     @relation(fields: [proyecto_id], references: [id])
  tags          Tag[]        @relation("FinalTags")

  // Nueva relación con Actividad (N:1)
  actividad_id  Int
  actividad     Actividad    @relation(fields: [actividad_id], references: [id])
}

model Tag {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  finales Final[]  @relation("FinalTags")
}

enum EstadoFinal {
  aprobado
  rechazado
  pendiente
}

enum FaseFinal {
  perfil
  proyecto
  tesis
}


enum EstadoActividad {
  activo
  cerrado
}


enum Rol {
  admin
  docente
  estudiante
}

enum Grado {
  grado1
  grado2
}

enum FaseProyecto {
  tema
  perfil
  proyecto
}

enum EstadoDocumento {
  pendiente
  en_revision
  revisado
  aprobado
  rechazado
}
