              "status": "OK",
              "code": 200,
              "header": [],
              "cookie": [
                {
                  "name": "access_token",
                  "value": "{{access_token}}",
                  "domain": "localhost"
                }
              ],
              "body": "{\"message\": \"Login exitoso\", \"user\": {\"id\": 1, \"email\": \"admin@example.com\", \"rol\": \"admin\"}}"
            }
