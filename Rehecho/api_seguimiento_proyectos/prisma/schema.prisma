// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int         @id @default(autoincrement())
  nombre         String
  apellido       String
  email          String      @unique
  hash           String
  rol            Rol
  refresh_token  String?
  estudiante     Estudiante?
  docente        Docente?
}

model Grupo {
  id                    Int        @id @default(autoincrement())
  nombre                String
  grado                 Grado
  estudiantes           Estudiante[]
  docente_id            Int?
  docente               Docente?   @relation(fields: [docente_id], references: [id])
  actividades           Actividad[]

  total_actividades     Int        @default(0)
  total_estudiantes     Int        @default(0)
  fase                  String     @default("Inicial")
  fecha_ultima_actividad DateTime?
}


model Estudiante {
  id            Int        @id
  usuario       Usuario    @relation(fields: [id], references: [id])
  cu            String
  carrera       String
  grupo_id      Int?
  grupo         Grupo?     @relation(fields: [grupo_id], references: [id])
  proyecto_id   Int?       
  proyecto      Proyecto?  @relation("ProyectoEstudiantes", fields: [proyecto_id], references: [id])
}

model Proyecto {
  id               Int             @id @default(autoincrement())
  titulo           String
  fase_actual      FaseProyecto
  grado_actual     Grado
  estudiantes      Estudiante[]    @relation("ProyectoEstudiantes")
  documentos       Documento[]     @relation("ProyectoDocumentos")
  observaciones    Observacion[]   @relation("ProyectoObservaciones")
}

model Documento {
  id             Int             @id @default(autoincrement())
  titulo         String
  version        Int
  estado         EstadoDocumento
  justificacion  String?
  created_at     DateTime @default(now())
  file           String

  proyecto_id    Int
  proyecto       Proyecto        @relation("ProyectoDocumentos", fields: [proyecto_id], references: [id])

  actividad_id   Int
  actividad      Actividad       @relation(fields: [actividad_id], references: [id])

  observaciones  Observacion[]   @relation("DocumentoObservaciones")
  correcciones   Correccion[]    @relation("DocumentoCorrecciones")
}

model Observacion {
  id             Int       @id @default(autoincrement()) 
  content_text   String?
  comment_text   String?
  comment_emoji  String?
  estado         String

  bounding_x1    Float
  bounding_y1    Float
  bounding_x2    Float
  bounding_y2    Float
  bounding_page  Int
  rects          Json

  // 🔁 Este campo se llena cuando la observación surge de una corrección rechazada
  correccion_id  Int?   @unique
  correccion     Correccion? @relation("CorreccionToObservacion", fields: [correccion_id], references: [id])

  // 🔁 Una observación puede tener una corrección (normal flujo estudiante → docente)
  respuesta      Correccion? @relation("ObservacionToCorreccion")

  documento_id   Int
  proyecto_id    Int

  proyecto       Proyecto      @relation("ProyectoObservaciones", fields: [proyecto_id], references: [id])
  documento      Documento     @relation("DocumentoObservaciones", fields: [documento_id], references: [id])
}

model Correccion {
  id              Int   @id @default(autoincrement())
  content_text    String?
  comment_text    String?
  comment_emoji   String?
  estado          String

  bounding_x1     Float
  bounding_y1     Float
  bounding_x2     Float
  bounding_y2     Float
  bounding_page   Int
  rects           Json     

  // 🔁 Corrección responde a una observación (normal flujo)
  observacion_id  Int   @unique
  observacion     Observacion @relation("ObservacionToCorreccion", fields: [observacion_id], references: [id])

  // 🔁 Corrección puede haber sido rechazada → genera nueva observación
  observacion_rechazo Observacion? @relation("CorreccionToObservacion")

  documento_id    Int
  documento       Documento @relation("DocumentoCorrecciones", fields: [documento_id], references: [id])
}


model Docente {
  id        Int       @id
  especialidad String
  usuario   Usuario   @relation(fields: [id], references: [id])
  grupos    Grupo[]
}

model Actividad {
  id             Int       @id @default(autoincrement())
  nombre         String
  elementos      Json      // lista de elementos requeridos (JSON)
  descripcion    String?
  fecha_creacion DateTime  @default(now())
  estado         EstadoActividad @default(activo)

  // Relación con Grupo (N:1)
  grupo_id       Int
  grupo          Grupo     @relation(fields: [grupo_id], references: [id])

  // Relación con Documento (1:N)
  documentos     Documento[]
}

enum EstadoActividad {
  activo
  cerrado
}


enum Rol {
  admin
  docente
  estudiante
}

enum Grado {
  grado1
  grado2
}

enum FaseProyecto {
  tema
  perfil
  proyecto
}

enum EstadoDocumento {
  pendiente
  en_revision
  revisado
  aprobado
  rechazado
}
